# yaml-language-server: $schema=https://nfpm.goreleaser.com/schema.json

name: browsing-exp
arch: all
platform: linux
version: 1.0.0
release: 1

maintainer: Carbonwarp <support@carbonwarp.com>
vendor: Carbonwarp
homepage: https://carbonwarp.com
license: GPL-v3
description: Enhancing browser experience.

contents:
  - src: browsing-exp/upstream_bin/
    dst: /usr/share/carbonwarp-surf/
    type: tree

  - src: browsing-exp/carbonwarp.json
    dst: /etc/brave/policies/managed/carbonwarp.json
    
  - src: browsing-exp/Local State
    dst: /etc/skel/.config/BraveSoftware/Brave-Origin/Local State

rpm:
  buildhost: milkyway
  signature:
    key_file: private.asc


