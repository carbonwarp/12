<aside class="sticky top-0 flex h-dvh min-h-0 flex-col border-r border-line bg-rail px-3.5 pt-[22px] pb-3.5 transition-colors duration-300 max-compact:px-2 max-compact:pt-[18px] max-compact:pb-2.5">
  <div class="flex items-center gap-[11px] px-2.5 pt-[3px] pb-[22px] font-bold max-compact:justify-center max-compact:px-0 max-compact:pb-5">
    <div class="grid h-8 w-[31px] flex-none place-items-center"><img class="block size-full" src="/favicon.svg" alt="" width="31" height="32"></div>
    <span class="max-compact:hidden">Carbonwarp Surf</span>
  </div>
  <div class="min-h-0 flex-1 overflow-y-auto [scrollbar-width:thin]" id="railSections"></div>
  <div class="mt-2 border-t border-line px-1 pt-3">
    <button class="flex w-full items-center gap-[11px] rounded-[10px] p-2.5 text-left text-ink-dim hover:bg-white/5 hover:text-ink max-compact:justify-center max-compact:px-0" id="openSettings" type="button"><span>⚙</span><span class="max-compact:hidden">Customize</span></button>
