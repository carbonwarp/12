---
import '../styles/base.css';
import { CONFIG, BACKGROUNDS } from '../scripts/config.js';
import { backgroundCss, imageCss } from '../scripts/theme.js';


// Default theme is written onto <html> at build time, and a tiny inline script swaps in the
// saved one before first paint, so the page never flashes the default background.
const [fallback] = BACKGROUNDS;
const rootStyle = `--bg-base:${fallback.colors[0]};--page-bg:${backgroundCss(fallback)}`;
const themes = Object.fromEntries(BACKGROUNDS.map(b => [b.id, { base: b.colors[0], css: backgroundCss(b) }]));
const storageKey = CONFIG.storageKey;
const imageTemplate = imageCss('%URL%');
---
<!doctype html>
<html lang="en" class="scroll-smooth font-sans [color-scheme:dark] motion-reduce:scroll-auto" style={rootStyle}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="icon" href="/favicon.svg">
  <title>New Tab</title>
  <script is:inline define:vars={{ themes, storageKey, imageTemplate }}>
    try {
      const saved = JSON.parse(localStorage.getItem(storageKey)) || {};
      const theme = themes[saved.background] || themes.default;
      const root = document.documentElement.style;
      root.setProperty('--bg-base', theme.base);
      root.setProperty('--page-bg', saved.backgroundImage ? imageTemplate.replace('%URL%', () => saved.backgroundImage) : theme.css);
    } catch {}
  </script>
</head>
<body class="m-0 min-h-screen bg-(image:--page-bg) bg-cover bg-fixed bg-center text-ink">
  <slot />
</body>
</html>
