# yaml-language-server: $schema=https://nfpm.goreleaser.com/schema.json

name: carbonwarp-logos
arch: all
platform: linux
version: 1.0.0
release: 1

maintainer: Carbonwarp <support@carbonwarp.com>
vendor: Carbonwarp
homepage: https://carbonwarp.com
license: GPL-v3
description: carbonwarp-icons


contents:
  - src: carbonwarp-logos/etc/dconf/db/gdm.d/90-carbonwarp-logo
    dst: /etc/dconf/db/gdm.d/90-carbonwarp-logo
    type: config|noreplace
    
  - src: carbonwarp-logos/etc/fastfetch/config.jsonc
    dst: /etc/fastfetch/config.jsonc
    type: config|noreplace

  - src: carbonwarp-logos/usr/
    dst: /usr/
    type: tree
    
provides:
  - system-logos
  - fedora-logos 
  - redhat-logos
  
conflicts:
  - fedora-logos
  - fedora-remix-logos
  - fedora-logos-httpd
  - fedora-logos-classic
 
replaces:
  - fedora-logos
  - fedora-remix-logos
  - fedora-logos-httpd
  - fedora-logos-classic
  
scripts:
  postinstall: carbonwarp-logos/post.sh
  
rpm:
  buildhost: milkyway
  signature:
    key_file: private.asc


