{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/carbonwarp/logo.txt",
    "color": { "1": "38;2;170;0;0" }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    {
      "type": "disk",
      "folders": "/var"
    },
    "localip",
    "locale",
    "break",
    "colors"
  ]
}
